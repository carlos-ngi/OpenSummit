# the only thing you really need
DISCORD_TOKEN=

# where the bot posts. you can also set this in discord with /settings channel
CHANNEL_ID=

# optional: your server id, makes the slash commands show up instantly
GUILD_ID=

# how often to check, in minutes (forecasts update about once an hour anyway)
POLL_MINUTES=60

# default rules, can be changed later with /settings rules
MIN_NIGHT_C=8
MAX_DAY_C=26
MAX_RAIN_MM=0.2
MAX_RAIN_CHANCE=50
MAX_WIND_KMH=25
